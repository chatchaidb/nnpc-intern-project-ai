        "options": {}
      },
      "id": "log-escalation",
      "name": "Log Escalation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        640,
        -160
      ],
      "disabled": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "output",
              "value": "ขออภัยครับ/ค่ะ คำถามนี้เกินขอบเขตข้อมูลที่มี ได้ส่งต่อให้เจ้าหน้าที่แล้ว จะติดต่อกลับโดยเร็วที่สุด\n\n(Escalated to a human agent.)",
              "type": "string"
            },
            {
              "id": "e2",
              "name": "status",
              "value": "escalated",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "respond-escalated",
      "name": "Respond Escalated",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        -160
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "APPROVER_EMAIL_PLACEHOLDER",
        "subject": "=[NNPC CS] Approval needed — {{ $('Normalize Input').item.json.tenant }}",
        "message": "=คำถามจากลูกค้า / Customer question:\n\n{{ $('Normalize Input').item.json.question }}\n\n--- ร่างคำตอบ / Drafted answer ---\n\n{{ $('AI Agent').item.json.output }}\n\nกด Approve เพื่อส่งคำตอบนี้ให้ลูกค้า",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {}
      },
      "id": "gmail-approval",
      "name": "Gmail Approval",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        640,
        160
      ],
      "disabled": true,
      "webhookId": "nnpc-cs-approval"
    },
    {
