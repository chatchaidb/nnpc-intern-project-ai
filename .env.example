# --- LLM serving (OpenAI-compatible) ---
# The on-prem server already serves these; we call them, we don't host them.
# Reached over VPN — put the server address in your local .env, never here.
#   Ollama  :11434/v1   chat + embeddings (what the workflows use today)
#   vLLM    :8010/v1    same Typhoon model, higher throughput
LLM_BASE_URL=http://localhost:11434/v1
# Candidate models — switchable via this one variable:
#   scb10x/llama3.1-typhoon2-8b-instruct:latest   (default — Thai-tuned, in use)
#   Qwen/Qwen3-8B                                 (untested here; compare on the
#                                                  eval set before switching)
LLM_MODEL=scb10x/llama3.1-typhoon2-8b-instruct:latest
LLM_API_KEY=dummy

# --- Embeddings ---
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=qwen3-embedding:latest

# --- Qdrant ---
# Dev collection nnpc_docs; the server's nnpc_kb is empty and unused.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nnpc_docs

# --- Langfuse (leave empty to disable tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
