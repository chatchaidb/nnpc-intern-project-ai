# --- LLM serving (vLLM, OpenAI-compatible) ---
# Point at the on-prem AI server in normal dev; localhost if running vLLM yourself.
LLM_BASE_URL=http://localhost:8001/v1
# Candidate models — switchable via this one variable:
#   Qwen/Qwen3-8B                          (default — newest; formal comparison pending)
#   scb10x/llama3.1-typhoon2-8b-instruct   (Thai-optimized)
#   Qwen/Qwen2.5-7B-Instruct
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=dummy

# --- Embeddings (vLLM --task embed) ---
EMBED_BASE_URL=http://localhost:8002/v1
EMBED_MODEL=BAAI/bge-m3

# --- Langfuse (leave empty to disable tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
